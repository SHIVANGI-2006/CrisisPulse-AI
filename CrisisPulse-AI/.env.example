# ---- Database (Neon Postgres — set this up FIRST) ----
# This project is configured to deploy on Neon by default, so your data
# survives redeploys/restarts. Create a free project at https://neon.tech,
# open your project -> "Connection Details" -> copy the "Connection string"
# (make sure "Pooled connection" is ON if you'll run multiple workers), then
# paste it here:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Only used as a local-dev fallback if DATABASE_URL is left empty above.
# Not recommended once you deploy — see README.
LOCAL_DB_PATH=database/crisis.db

# ---- Groq (required for live analysis) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60

# ---- Tavily (optional, enables the Live Verification Agent) ----
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=
ENABLE_LIVE_VERIFICATION=true

# ---- App behaviour ----
# If true, the app shows sample output instead of erroring when GROQ_API_KEY is missing.
DEMO_MODE=true
SECRET_KEY=change-this-secret-key
PORT=7860
